<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration d'artefact SignPath « programme » (slug : programme).
  Le fichier envoyé par GitHub Actions est un zip contenant :
    app/ClasseControle.exe      version installée (installateur, portable, mise à jour auto)
    single/ClasseControle.exe   version « un seul fichier »
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="app/ClasseControle.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="single/ClasseControle.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
